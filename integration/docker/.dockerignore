# Docker build context optimization
# Only include necessary files to speed up builds

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation build artifacts
docs/_build/
docs/.doctrees/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Model outputs and checkpoints (don't include in image)
output/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
model_cache/

# Data (should be mounted at runtime)
data/
datasets/
*.jsonl
*.csv
*.parquet

# Secrets and credentials (NEVER include)
.env
.env.*
*.key
*.pem
credentials.json
secrets.yaml

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
cicd/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Large files that shouldn't be in image
*.tar
*.tar.gz
*.zip
*.7z
*.rar
