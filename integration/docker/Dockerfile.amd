# AMD GPU Docker Image for Automated Fine-Tuning
FROM rocm/pytorch:rocm6.0_ubuntu22.04_py3.10_pytorch_2.1.2

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git wget curl vim nano \
    build-essential ninja-build \
    libaio-dev pkg-config \
    && rm-rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install Flash Attention for ROCm (if available)
RUN pip3 install --no-cache-dir triton || true

# Set working directory
WORKDIR /workspace

# Copy Axolotl source
COPY . /workspace/axolotl

# Install Axolotl with ROCm support
WORKDIR /workspace/axolotl
RUN pip3 install --no-cache-dir -e .[deepspeed,optimizers]

# Install integration layer
COPY integration/ /workspace/integration/
RUN pip3 install --no-cache-dir pyyaml

# Install cloud storage clients
RUN pip3 install --no-cache-dir \
    boto3 \
    azure-storage-blob \
    google-cloud-storage \
    huggingface_hub[cli]

# Install monitoring tools
RUN pip3 install --no-cache-dir \
    pymongo \
    wandb \
    mlflow \
    tensorboard

# Install API dependencies
RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    pydantic

# Create workspace directories
RUN mkdir -p /workspace/data /workspace/output /workspace/checkpoints

# Set working directory
WORKDIR /workspace

# Copy entrypoint script
COPY integration/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Default command
CMD ["python3", "/workspace/integration/train_wrapper.py", "--job-config", "/workspace/job_config.yaml"]
