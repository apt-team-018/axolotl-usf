# Environment variables for Axolotl USF Docker deployment
# Copy this file to .env and fill in your values

# ==============================================================================
# Training Configuration
# ==============================================================================

# Data directories (local paths)
DATA_DIR=./data
OUTPUT_DIR=./output
CHECKPOINT_DIR=./checkpoints
LOGS_DIR=./logs

# Distributed training (for multi-node setups)
WORLD_SIZE=1
GPUS_PER_NODE=1
MASTER_ADDR=localhost
MASTER_PORT=29500

# ==============================================================================
# Logging Configuration
# ==============================================================================

LOG_LEVEL=INFO
JSON_LOGS=false

# ==============================================================================
# GPU Configuration
# ==============================================================================

# Specify which GPUs to use (comma-separated indices or "all")
CUDA_VISIBLE_DEVICES=all

# NCCL debugging (set to INFO for troubleshooting distributed training)
NCCL_DEBUG=WARN
NCCL_SOCKET_IFNAME=eth0
NCCL_IB_DISABLE=0

# PyTorch distributed debugging
TORCH_DISTRIBUTED_DEBUG=OFF

# ==============================================================================
# Monitoring & Experiment Tracking
# ==============================================================================

# Weights & Biases
WANDB_API_KEY=

# MLflow
MLFLOW_TRACKING_URI=

# MongoDB (for custom metrics)
MONGODB_URI=
MONGO_USERNAME=admin
MONGO_PASSWORD=changeme

# ==============================================================================
# Cloud Storage - AWS
# ==============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use instance role (preferred for EC2/ECS)
# AWS_ROLE_ARN=

# ==============================================================================
# Cloud Storage - Azure
# ==============================================================================

AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
# Or use managed identity (preferred for Azure VMs)

# ==============================================================================
# Cloud Storage - Google Cloud
# ==============================================================================

GCS_PROJECT_ID=
# Use service account key file or workload identity

# ==============================================================================
# HuggingFace
# ==============================================================================

# Cache directory
HF_HOME=~/.cache/huggingface

# API token (for private models)
HF_TOKEN=

# ==============================================================================
# Secrets Management (Optional)
# ==============================================================================

# HashiCorp Vault
VAULT_ADDR=
VAULT_TOKEN=

# AWS Secrets Manager
# (uses AWS credentials above)

# ==============================================================================
# Resource Limits (Optional)
# ==============================================================================

# Memory limits (uncomment and adjust in docker-compose.yml)
# MEM_LIMIT=64g
# SHM_SIZE=32gb
